<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <function model="ir.actions.report" name="_barani_commercial_adopt_metadata"/>
  <record id="barani_commercial.paperformat_commercial" model="report.paperformat">
    <field name="name">BARANI Commercial A4 7mm</field>
    <field name="format">A4</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top" eval="40.0"/>
    <field name="margin_bottom" eval="18.0"/>
    <field name="margin_left" eval="7.0"/>
    <field name="margin_right" eval="7.0"/>
    <field name="header_line" eval="False"/>
    <field name="header_spacing" eval="35.0"/>
    <field name="dpi" eval="90"/>
    <field name="page_width" eval="0.0"/>
    <field name="page_height" eval="0.0"/>
    <field name="disable_shrinking" eval="False"/>
    <field name="css_margins" eval="False"/>
    <field name="default" eval="False"/>
  </record>
  <record id="barani_commercial.action_report_saleorder_2026" model="ir.actions.report">
    <field name="name">Quotation / Order — 2026+</field>
    <field name="model">sale.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">barani_commercial.report_saleorder</field>
    <field name="report_file">barani_commercial.report_saleorder</field>
    <field name="binding_type">report</field>
    <field name="binding_view_types">list,form</field>
    <field name="print_report_name">(((object.name or '')[3:] if (object.name or '')[:3] in ('SO/','PF/') else (object.name or '')[2:] if (object.name or '')[:2] == 'Q/' else (object.name or ''))).replace('/', '_') + (' - Quotation' if object.state in ('draft','sent','cancel') else ' - Sales Order')</field>
    <field name="paperformat_id" ref="barani_commercial.paperformat_commercial"/>
    <field name="binding_model_id" eval="False"/>
    <field name="group_ids" eval="[(6, 0, [ref('sales_team.group_sale_salesman'), ref('sales_team.group_sale_salesman_all_leads'), ref('sales_team.group_sale_manager'), ref('account.group_account_invoice')])]"/>
    <field name="attachment" eval="False"/>
    <field name="attachment_use" eval="False"/>
  </record>
  <record id="barani_commercial.action_report_proforma_2026" model="ir.actions.report">
    <field name="name">PRO-FORMA — 2026+</field>
    <field name="model">sale.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">barani_commercial.report_saleorder_proforma</field>
    <field name="report_file">barani_commercial.report_saleorder_proforma</field>
    <field name="binding_type">report</field>
    <field name="binding_view_types">list,form</field>
    <field name="print_report_name">(((object.name or '')[3:] if (object.name or '')[:3] in ('SO/','PF/') else (object.name or '')[2:] if (object.name or '')[:2] == 'Q/' else (object.name or ''))).replace('/', '_') + ' - Pro-Forma Invoice'</field>
    <field name="paperformat_id" ref="barani_commercial.paperformat_commercial"/>
    <field name="binding_model_id" eval="False"/>
    <field name="group_ids" eval="[(6, 0, [ref('sales_team.group_sale_salesman'), ref('sales_team.group_sale_salesman_all_leads'), ref('sales_team.group_sale_manager'), ref('account.group_account_invoice')])]"/>
    <field name="attachment" eval="False"/>
    <field name="attachment_use" eval="False"/>
  </record>
</odoo>
