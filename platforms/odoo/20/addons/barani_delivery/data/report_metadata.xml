<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <function model="ir.actions.report" name="_barani_delivery_adopt_metadata"/>
  <record id="barani_delivery.paperformat_delivery" model="report.paperformat">
    <field name="name">BARANI Delivery A4 7mm</field>
    <field name="format">A4</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top" eval="40.0"/>
    <field name="margin_bottom" eval="18.0"/>
    <field name="margin_left" eval="7.0"/>
    <field name="margin_right" eval="7.0"/>
    <field name="header_line" eval="False"/>
    <field name="header_spacing" eval="35.0"/>
    <field name="dpi" eval="90"/>
    <field name="page_width" eval="0.0"/>
    <field name="page_height" eval="0.0"/>
    <field name="disable_shrinking" eval="False"/>
    <field name="css_margins" eval="False"/>
    <field name="default" eval="False"/>
  </record>
  <record id="barani_delivery.paperformat_picking_operations" model="report.paperformat">
    <field name="name">BARANI Picking Operations A4 7mm</field>
    <field name="format">A4</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top" eval="40.0"/>
    <field name="margin_bottom" eval="18.0"/>
    <field name="margin_left" eval="7.0"/>
    <field name="margin_right" eval="7.0"/>
    <field name="header_line" eval="False"/>
    <field name="header_spacing" eval="35.0"/>
    <field name="dpi" eval="90"/>
    <field name="page_width" eval="0.0"/>
    <field name="page_height" eval="0.0"/>
    <field name="disable_shrinking" eval="False"/>
    <field name="css_margins" eval="False"/>
    <field name="default" eval="False"/>
  </record>
  <record id="barani_delivery.action_report_delivery_note" model="ir.actions.report">
    <field name="name">Delivery Slip</field>
    <field name="model">stock.picking</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">barani_delivery.report_delivery_note_2026</field>
    <field name="report_file">barani_delivery.report_delivery_note_2026</field>
    <field name="binding_type">report</field>
    <field name="binding_view_types">list,form</field>
    <field name="print_report_name">(((object.name or '')[7:] if (object.name or '')[:7] == 'BA/OUT/' else (object.name or 'DN')).replace('/', '_')) + ' - Delivery Note'</field>
    <field name="paperformat_id" ref="barani_delivery.paperformat_delivery"/>
    <field name="binding_model_id" ref="stock.model_stock_picking"/>
    <field name="group_ids" eval="[(6, 0, [ref('sales_team.group_sale_manager'), ref('stock.group_stock_user')])]"/>
    <field name="attachment" eval="False"/>
    <field name="attachment_use" eval="False"/>
  </record>
  <record id="barani_delivery.action_report_sale_delivery_note" model="ir.actions.report">
    <field name="name">Delivery Note</field>
    <field name="model">sale.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">barani_delivery.report_sale_order_delivery_note_2026</field>
    <field name="report_file">barani_delivery.report_sale_order_delivery_note_2026</field>
    <field name="binding_type">report</field>
    <field name="binding_view_types">list,form</field>
    <field name="print_report_name">(((((object.picking_ids.filtered_domain([('picking_type_id.code','=','outgoing'),('state','!=','cancel')])).name or '')[7:] if ((object.picking_ids.filtered_domain([('picking_type_id.code','=','outgoing'),('state','!=','cancel')])).name or '')[:7] == 'BA/OUT/' else ((object.picking_ids.filtered_domain([('picking_type_id.code','=','outgoing'),('state','!=','cancel')])).name or 'DN'))).replace('/', '_') + ' - Delivery Note') if len(object.picking_ids.filtered_domain([('picking_type_id.code','=','outgoing'),('state','!=','cancel')])) == 1 else ((((object.name or '')[3:] if (object.name or '')[:3] in ('SO/','PF/') else (object.name or '')[2:] if (object.name or '')[:2] == 'Q/' else (object.name or ''))).replace('/', '_') + (' - Delivery Notes' if len(object.picking_ids.filtered_domain([('picking_type_id.code','=','outgoing'),('state','!=','cancel')])) &gt; 1 else ' - Delivery Note Unavailable'))</field>
    <field name="paperformat_id" ref="barani_delivery.paperformat_delivery"/>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="group_ids" eval="[(6, 0, [])]"/>
    <field name="attachment" eval="False"/>
    <field name="attachment_use" eval="False"/>
  </record>
  <record id="barani_delivery.action_report_picking_operations" model="ir.actions.report">
    <field name="name">Picking Operations</field>
    <field name="model">stock.picking</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">barani_delivery.report_picking_operations_2026</field>
    <field name="report_file">barani_delivery.report_picking_operations_2026</field>
    <field name="binding_type">report</field>
    <field name="binding_view_types">list,form</field>
    <field name="print_report_name">(((object.name or '')[7:] if (object.name or '')[:7] == 'BA/OUT/' else (object.name or 'Picking')).replace('/', '_')) + ' - Picking Operations'</field>
    <field name="paperformat_id" ref="barani_delivery.paperformat_picking_operations"/>
    <field name="binding_model_id" ref="stock.model_stock_picking"/>
    <field name="group_ids" eval="[(6, 0, [ref('stock.group_stock_user')])]"/>
    <field name="attachment" eval="False"/>
    <field name="attachment_use" eval="False"/>
  </record>
  <record id="stock.action_report_delivery" model="ir.actions.report">
    <field name="binding_model_id" eval="False"/>
  </record>
  <record id="stock.action_report_picking" model="ir.actions.report">
    <field name="binding_model_id" eval="False"/>
  </record>
  <function model="ir.actions.report" name="_barani_delivery_sync_labels"/>
</odoo>
