<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="report_purchaseorder">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t t-call="barani_purchase.report_purchaseorder_document" t-lang="'en_US'">
          <t t-set="o" t-value="doc.with_company(doc.company_id).with_context(lang='en_US')"/>
        </t>
      </t>
    </t>
  </template>

  <template id="report_purchaseorder_document">
    <t t-set="barani_purchase_title" t-value="'Cancelled Purchase Order' if o.state == 'cancel' else 'Purchase Order' if o.state == 'purchase' else 'Request for Quotation'"/>
    <t t-call="barani_purchase.external_layout_purchase">
      <style>
        .barani_po_doc { font-size:10pt; line-height:1.25; }
        .barani_po_addresses { display:table; width:100%; table-layout:fixed; margin:0 0 6px; }
        .barani_po_addresses &gt; div { display:table-cell; width:50%; vertical-align:top; word-wrap:break-word; }
        .barani_po_supplier { padding-right:18px; }
        .barani_po_shipping { padding-left:10mm; }
        .barani_po_info { display:table; width:100%; table-layout:fixed; margin:5px 0 8px; }
        .barani_po_info &gt; div { display:table-cell; vertical-align:top; padding-right:6px; word-wrap:break-word; }
        .barani_po_info p { margin:0; }
        .barani_po_table { table-layout:fixed; width:100%; font-size:10pt; line-height:1.2; }
        .barani_po_table th, .barani_po_table td { padding:2px 3px; vertical-align:top; }
        .barani_po_table thead { display:table-header-group; }
        .barani_po_table tr { page-break-inside:avoid; }
        .barani_po_table .po_description, .barani_po_table .po_unit { word-wrap:break-word; }
        .barani_po_table .po_number { white-space:nowrap; }
        .barani_po_table .po_qty, .barani_po_table .po_unit_price { font-size:9pt; white-space:nowrap; }
        .barani_po_closing { page-break-inside:avoid; margin-top:4px; }
        .barani_po_terms_totals { display:table; width:100%; table-layout:fixed; }
        .barani_po_terms { display:table-cell; width:57%; padding-right:12px; vertical-align:top; }
        .barani_po_totals { display:table-cell; width:43%; vertical-align:top; }
        .barani_po_totals td { padding:2px 3px; }
        .barani_po_totals .text-end { padding-right:10px; white-space:nowrap; }
        .barani_po_prepared { text-align:right; margin-top:12px; padding-right:10px; }
        .barani_po_notes { margin-top:8px; word-wrap:break-word; }
      </style>
      <div class="page barani_po_doc">
        <div class="barani_po_addresses">
          <div class="barani_po_supplier" name="barani_po_supplier">
            <strong t-att-style="'color:%s;' % (o.company_id.secondary_color or '#ed1c24')">Supplier:</strong>
            <div t-field="o.partner_id" t-options="{'widget': 'contact', 'fields': ['address', 'name'], 'no_marker': True}"/>
            <t t-set="supplier_legal" t-value="o.partner_id.commercial_partner_id"/>
            <div t-if="supplier_legal.company_registry">ID: <span t-field="supplier_legal.company_registry"/></div>
            <div t-if="supplier_legal.vat">VAT: <span t-field="supplier_legal.vat"/></div>
            <div t-if="o.partner_id.phone">Tel: <span t-field="o.partner_id.phone"/></div>
            <div t-if="o.partner_id.email">Email: <span t-field="o.partner_id.email"/></div>
          </div>
          <div class="barani_po_shipping" name="barani_po_shipping">
            <strong t-att-style="'color:%s;' % (o.company_id.secondary_color or '#ed1c24')">Delivery address:</strong>
            <t t-if="o.dest_address_id">
              <div t-field="o.dest_address_id" t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone', 'email'], 'no_marker': True, 'phone_icons': False}"/>
            </t>
            <t t-elif="o.picking_type_id.warehouse_id">
              <div t-field="o.picking_type_id.warehouse_id.name"/>
              <div t-field="o.picking_type_id.warehouse_id.partner_id" t-options="{'widget': 'contact', 'fields': ['address', 'phone', 'email'], 'no_marker': True, 'phone_icons': False}"/>
            </t>
            <div t-else="">Not specified</div>
          </div>
        </div>

        <div class="barani_po_info" name="barani_po_information">
          <div style="width:25%;"><strong>Buyer</strong><p t-field="o.user_id.name"/></div>
          <div style="width:25%;"><strong>Supplier Reference</strong><p t-out="o.partner_ref or '—'"/></div>
          <div style="width:18%;">
            <t t-if="o.date_approve and o.state in ('purchase', 'cancel')"><strong>Order Date</strong><p t-field="o.date_approve" t-options="{'format': 'dd MMM yyyy'}"/></t>
            <t t-else=""><strong>Order Deadline</strong><p t-field="o.date_order" t-options="{'format': 'dd MMM yyyy'}"/></t>
          </div>
          <div style="width:22%;"><strong>Expected Arrival</strong><p t-field="o.date_planned" t-options="{'format': 'dd MMM yyyy'}"/></div>
          <div style="width:10%;"><strong>Currency</strong><p t-field="o.currency_id.name"/></div>
        </div>

        <!-- Invoice column order and widths; unit prices keep Odoo Product Price
             precision (0.0119 must not be displayed as 0.01). -->
        <table class="table table-sm o_main_table barani_po_table" name="barani_po_lines">
          <colgroup>
            <col style="width:37%"/><col style="width:8%"/><col style="width:5%"/>
            <col style="width:6.5%"/><col style="width:7%"/><col style="width:8%"/>
            <col style="width:5.5%"/><col style="width:5.5%"/><col style="width:7.5%"/><col style="width:10%"/>
          </colgroup>
          <thead>
            <tr>
              <th class="text-start">Description</th><th class="text-start">HS Code</th>
              <th class="text-center">COO</th><th class="text-end">Qty</th><th class="text-start">Unit</th>
              <th class="text-end">Unit Price</th><th class="text-end">Disc.</th>
              <th class="text-end">VAT Rate</th><th class="text-end">VAT</th><th class="text-end">VAT Base</th>
            </tr>
          </thead>
          <tbody>
            <t t-set="po_lines" t-value="o.order_line.filtered(lambda line: line.display_type or line.product_qty != 0)"/>
            <t t-set="current_section" t-value="False"/><t t-set="current_subtotal" t-value="0.0"/>
            <t t-foreach="po_lines" t-as="line">
              <tr t-if="not line.display_type" name="barani_po_product_line">
                <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                <td class="po_description" name="td_description">
                  <span t-field="line.name" t-options="{'widget': 'text'}"/>
                  <div t-if="line.date_planned and o.date_planned and line.date_planned.date() != o.date_planned.date()" class="text-muted" style="font-size:8pt;">
                    Expected: <span t-field="line.date_planned" t-options="{'format': 'dd MMM yyyy'}"/>
                  </div>
                </td>
                <td name="td_hscode"><span t-if="'hs_code' in line.product_id._fields and line.product_id.hs_code" t-field="line.product_id.hs_code"/></td>
                <td name="td_coo" class="text-center"><span t-if="'country_of_origin' in line.product_id._fields and line.product_id.country_of_origin" t-field="line.product_id.country_of_origin.code"/></td>
                <td name="td_qty" class="text-end po_qty"><span t-field="line.product_qty"/></td>
                <td name="td_unit" class="po_unit"><span t-field="line.product_uom_id.name"/></td>
                <td name="td_priceunit" class="text-end po_unit_price"><span t-field="line.price_unit"/></td>
                <td name="td_discount" class="text-end"><span class="po_number" t-field="line.discount"/> %</td>
                <td name="td_vatrate" class="text-end">
                  <t t-set="po_taxes" t-value="line.tax_ids.flatten_taxes_hierarchy()"/>
                  <t t-foreach="po_taxes" t-as="po_tax">
                    <div class="po_number" t-if="po_tax.amount_type in ('percent', 'division')"><span t-out="'%g' % po_tax.amount"/> %</div>
                    <div t-else=""><span t-field="po_tax.name"/></div>
                  </t>
                  <span t-if="not po_taxes">N/A</span>
                </td>
                <td name="td_vatamount" class="text-end po_number"><span t-out="line.price_total - line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                <td name="td_vatbase" class="text-end po_number"><span t-field="line.price_subtotal"/></td>
              </tr>
              <tr t-elif="line.display_type in ('line_section', 'line_subsection')" class="bg-200 fw-bold o_line_section">
                <td colspan="10"><span t-field="line.name" t-options="{'widget': 'text'}"/></td>
                <t t-set="current_section" t-value="line"/><t t-set="current_subtotal" t-value="0.0"/>
              </tr>
              <tr t-elif="line.display_type == 'line_note'" class="fst-italic o_line_note">
                <td colspan="10"><span t-field="line.name" t-options="{'widget': 'text'}"/></td>
              </tr>
              <tr t-if="current_section and (line_last or po_lines[line_index + 1].display_type in ('line_section', 'line_subsection'))" class="text-end">
                <td colspan="10"><strong>Subtotal: </strong><span t-out="current_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
              </tr>
            </t>
          </tbody>
        </table>

        <div class="barani_po_closing">
          <div class="barani_po_terms_totals">
            <div class="barani_po_terms">
              <div t-if="o.payment_term_id"><strong>Payment Terms: </strong><span t-field="o.payment_term_id.name"/></div>
              <div t-if="o.incoterm_id"><strong>INCOTERMS: </strong><span t-field="o.incoterm_id.code"/> — <span t-field="o.incoterm_id.name"/><t t-if="o.incoterm_location"> — <span t-field="o.incoterm_location"/></t></div>
              <t t-set="line_tax_sum" t-value="sum(o.order_line.filtered(lambda line: not line.display_type).mapped('price_tax'))"/>
              <div t-if="o.currency_id.compare_amounts(line_tax_sum, o.amount_tax)" class="text-muted" style="font-size:8pt; margin-top:4px;">
                Tax totals follow Odoo's document rounding; displayed line tax amounts may differ in sum.
              </div>
            </div>
            <div class="barani_po_totals">
              <!-- Use the native tax summary, including tax groups and global rounding. -->
              <table class="table table-sm table-borderless" name="barani_po_tax_totals">
                <t t-call="purchase.document_tax_totals">
                  <t t-set="tax_totals" t-value="o.tax_totals"/>
                  <t t-set="currency" t-value="o.currency_id"/>
                </t>
              </table>
            </div>
          </div>
          <div class="barani_po_prepared"><strong>Prepared by: </strong><span t-field="o.user_id.name"/></div>
        </div>
        <!-- Only supplier-facing standard PO terms, never the Studio Internal Note. -->
        <div t-if="not is_html_empty(o.note)" class="barani_po_notes" name="barani_po_notes"><span t-field="o.note"/></div>
      </div>
    </t>
  </template>
</odoo>
