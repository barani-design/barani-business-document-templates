<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <function model="ir.actions.report" name="_barani_vat_adopt_metadata"/>
  <record id="barani_vat.paperformat_vat" model="report.paperformat">
    <field name="name">BARANI VAT A4 7mm</field>
    <field name="format">A4</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top" eval="40.0"/>
    <field name="margin_bottom" eval="18.0"/>
    <field name="margin_left" eval="7.0"/>
    <field name="margin_right" eval="7.0"/>
    <field name="header_line" eval="False"/>
    <field name="header_spacing" eval="35.0"/>
    <field name="dpi" eval="90"/>
    <field name="page_width" eval="0.0"/>
    <field name="page_height" eval="0.0"/>
    <field name="disable_shrinking" eval="False"/>
    <field name="css_margins" eval="False"/>
    <field name="default" eval="False"/>
  </record>
  <record id="barani_vat.action_report_vat_2026" model="ir.actions.report">
    <field name="name">VAT Invoices RI/DPI - 2026+</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">barani_vat.report_invoice_document_vat</field>
    <field name="report_file">barani_vat.report_invoice_document_vat</field>
    <field name="binding_type">report</field>
    <field name="binding_view_types">list,form</field>
    <field name="print_report_name">((object.name or '').replace('/', '_') + ' - ' if object.name and object.name != '/' else '') + ('Credit Note' if object.move_type == 'out_refund' else 'Vendor Credit Note' if object.move_type == 'in_refund' else 'Vendor Bill' if object.move_type == 'in_invoice' else 'Draft Invoice' if object.state == 'draft' else 'Cancelled Invoice' if object.state == 'cancel' else 'Invoice')</field>
    <field name="paperformat_id" ref="barani_vat.paperformat_vat"/>
    <field name="binding_model_id" eval="False"/>
    <field name="group_ids" eval="[(6, 0, [ref('sales_team.group_sale_manager'), ref('account.group_account_invoice')])]"/>
    <field name="attachment" eval="False"/>
    <field name="attachment_use" eval="False"/>
  </record>
  <record id="barani_vat.action_invoice_preview" model="ir.actions.report">
    <field name="name">Invoice Preview</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-html</field>
    <field name="report_name">barani_vat.report_invoice_document_vat</field>
    <field name="report_file">barani_vat.report_invoice_document_vat</field>
    <field name="binding_type">report</field>
    <field name="binding_view_types">form</field>
    <field name="print_report_name">((object.name or '').replace('/', '_') + ' - ' if object.name and object.name != '/' else '') + ('Credit Note' if object.move_type == 'out_refund' else 'Vendor Credit Note' if object.move_type == 'in_refund' else 'Vendor Bill' if object.move_type == 'in_invoice' else 'Draft Invoice' if object.state == 'draft' else 'Cancelled Invoice' if object.state == 'cancel' else 'Invoice')</field>
    <field name="paperformat_id" ref="barani_vat.paperformat_vat"/>
    <field name="binding_model_id" eval="False"/>
    <field name="group_ids" eval="[(6, 0, [])]"/>
    <field name="attachment" eval="False"/>
    <field name="attachment_use" eval="False"/>
  </record>
</odoo>
