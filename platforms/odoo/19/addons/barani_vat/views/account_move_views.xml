<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_move_form_barani_preview" model="ir.ui.view">
    <field name="name">account.move.form.barani.invoice.preview</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='preview_invoice']" position="attributes">
        <attribute name="name">%(barani_vat.action_invoice_preview)d</attribute>
        <attribute name="type">action</attribute>
        <attribute name="string">Invoice Preview</attribute>
      </xpath>
    </field>
  </record>
</odoo>
