<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="stock.action_report_delivery" model="ir.actions.report">
    <field name="report_name">barani_delivery.report_delivery_note_2026</field>
    <field name="report_file">barani_delivery.report_delivery_note_2026</field>
    <field name="paperformat_id" ref="barani_delivery.paperformat_delivery"/>
    <field name="print_report_name">(((object.name or '')[7:] if (object.name or '')[:7] == 'BA/OUT/' else (object.name or 'DN')).replace('/', '_')) + ' - Delivery Note'</field>
    <field name="binding_model_id" eval="False"/>
  </record>
  <record id="stock.action_report_picking" model="ir.actions.report">
    <field name="report_name">barani_delivery.report_picking_operations_2026</field>
    <field name="report_file">barani_delivery.report_picking_operations_2026</field>
    <field name="paperformat_id" ref="barani_delivery.paperformat_picking_operations"/>
    <field name="print_report_name">(((object.name or '')[7:] if (object.name or '')[:7] == 'BA/OUT/' else (object.name or 'Picking')).replace('/', '_')) + ' - Picking Operations'</field>
    <field name="binding_model_id" eval="False"/>
  </record>
</odoo>
