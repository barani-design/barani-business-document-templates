<t t-name="barani_vat.report_invoice_document_vat">
  <t t-call="web.html_container">
    <t t-foreach="docs" t-as="o">
      <t t-set="lang" t-value="'en_US'"/>
      <t t-call="barani_vat.external_layout_standard_titled" t-lang="lang">
        <t t-set="o" t-value="o.with_context(lang=lang)"/>
        <t t-set="forced_vat" t-value="o.fiscal_position_id.foreign_vat"/>
        <!-- L16 TODO 2A: VAT Date currently uses o.invoice_date as a stopgap; replace with the confirmed Slovak tax-point/supply-date field when available. -->
        <!-- L16 TODO 6: Customer VAT/status classification should be data-driven from fiscal position / partner VAT / country; do not infer legal status in QWeb alone. -->

        <!-- Scoped layout for the dense 10-column VAT table. Targets only .barani_vat_table; no other report affected. table-layout:fixed + per-column widths prevent right-margin clipping; description wraps, numerics stay on one line. -->
        <style>
          /* Unified 10pt body and table. Keep explicit sizes for wkhtmltopdf. */
          .barani_vat_doc { font-size: 10pt; line-height: 1.25; } .barani_addr_block { margin-top: -1px; margin-bottom: 0; } .barani_addr_block .barani_addr_cell { min-width: 0; box-sizing: border-box; word-wrap: break-word; overflow-wrap: break-word; } .barani_addr_block .barani_customer_cell { padding-left: 0; padding-right: 0; } .barani_addr_block .barani_customer_cell.barani_has_shipping { padding-right: 18px; } .barani_addr_block .barani_shipping_cell { padding-left: 10mm; padding-right: 0; } .barani_info_block { padding-top: 4px; margin-bottom:8px; }
          /* D03.6 metadata/header width map */
          #informations.barani_info_block &gt; div { padding-right: 6px; box-sizing: border-box; }
          #informations.barani_info_block &gt; div[name="invoice_date"] { flex: 0 0 13.5%; max-width: 13.5%; width: 13.5%; }
          #informations.barani_info_block &gt; div[name="vat_date"],
          #informations.barani_info_block &gt; div[name="due_date"] { flex: 0 0 11.5%; max-width: 11.5%; width: 11.5%; }
          #informations.barani_info_block &gt; div[name="origin"] { flex: 0 0 15%; max-width: 15%; width: 15%; }
          #informations.barani_info_block &gt; div[name="payment_reference"] { flex: 0 0 18%; max-width: 18%; width: 18%; }
          #informations.barani_info_block &gt; div[name="payment_method"] { flex: 0 0 30.5%; max-width: 30.5%; width: 30.5%; }
          #informations.barani_info_block &gt; div[name="barani_credit_original_invoice"] { flex: 0 0 18%; max-width: 18%; width: 18%; }
          #informations.barani_info_block &gt; div[name="barani_credit_original_payment_reference"] { flex: 0 0 30%; max-width: 30%; width: 30%; }
          #informations.barani_info_block strong,
          div[name="barani_payment_ref_cell"] strong { white-space: nowrap; }

          .barani_vat_table { table-layout: fixed; width: 100%; font-size: 10pt; line-height: 1.2; }
          .barani_vat_table th, .barani_vat_table td { padding: 2px 3px; vertical-align: top; overflow: hidden; }
          .barani_vat_table .text-nowrap { white-space: nowrap; }
          /* L11: right-side breathing room on totals + footer band cells */
          #total table.table-sm td.text-end { padding-right: 10px; }
          .barani_footer_band { padding-right: 10px; }
          .barani_down_payment_reconciliation_table { table-layout: fixed; width:100%; font-size:9pt; line-height:1.15; margin:6px 0 6px 0; }
          .barani_down_payment_reconciliation_table th, .barani_down_payment_reconciliation_table td { padding:2px 4px; vertical-align:top; }
          .barani_addr_heading { font-weight:bold; }
        </style>

        <!-- Fork A, DDS-free split. Positive 324 lines are down-payment invoice lines; negative 324 lines are settlement deductions. -->
        <t t-set="barani_dp_lines" t-value="o.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section','line_note') and l.account_id and l.account_id.code and l.account_id.code[:3] == '324' and (l.price_subtotal or 0.0) &gt;= -0.005)"/>
        <t t-set="barani_ded_lines" t-value="o.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section','line_note') and l.account_id and l.account_id.code and l.account_id.code[:3] == '324' and (l.price_subtotal or 0.0) &lt; -0.005)"/>
        <t t-set="barani_goods_lines" t-value="o.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section','line_note') and not (l.account_id and l.account_id.code and l.account_id.code[:3] == '324'))"/>
        <t t-set="barani_is_dp_only" t-value="barani_dp_lines and not barani_goods_lines and not barani_ded_lines"/>
        <t t-set="barani_table_lines" t-value="barani_dp_lines if barani_is_dp_only else barani_goods_lines"/>
        <t t-set="barani_total_base" t-value="sum(barani_table_lines.mapped('price_subtotal'))"/>
        <t t-set="barani_total_gross" t-value="sum(barani_table_lines.mapped('price_total'))"/>
        <t t-set="barani_total_vat" t-value="barani_total_gross - barani_total_base"/>
        <t t-set="barani_advance_applied" t-value="-sum(barani_ded_lines.mapped('price_total'))"/>
        <t t-set="barani_has_advance_deduction" t-value="bool(barani_ded_lines)"/>
        <t t-set="barani_dp_pos_lines" t-value="o.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section','line_note') and l.account_id and l.account_id.code and l.account_id.code[:3] == '324' and (l.price_subtotal or 0.0) &gt; 0.005)"/>
        <t t-set="barani_is_dp_invoice" t-value="bool(barani_dp_pos_lines) and not barani_goods_lines and not barani_has_advance_deduction"/>
        <!-- Official-display totals: use Odoo document totals when there is no 324 deduction, to preserve tax-rounding exactly; use goods-only totals on 324 settlement invoices. -->
        <t t-set="barani_line_vat_sum" t-value="barani_total_vat"/>
        <t t-set="barani_official_goods_total" t-value="(o.amount_total + barani_advance_applied) if barani_has_advance_deduction else o.amount_total"/>
        <t t-set="barani_official_goods_vat" t-value="barani_official_goods_total - barani_total_base"/>
        <t t-set="barani_goods_gross" t-value="barani_official_goods_total"/>
        <t t-set="barani_display_base" t-value="o.amount_untaxed"/>
        <t t-set="barani_display_vat" t-value="o.amount_tax"/>
        <t t-set="barani_display_total" t-value="o.amount_total"/>
        <t t-set="display_discount" t-value="True"/>
        <t t-set="barani_payment_ref_raw" t-value="'' if o.move_type == 'out_refund' else (o.invoice_origin or o.payment_reference or o.name or '')"/>
        <t t-set="barani_payment_ref_upper" t-value="(barani_payment_ref_raw or '').upper()"/>
        <t t-set="barani_pdf_payment_ref" t-value="barani_payment_ref_upper.replace('A', '').replace('B', '').replace('C', '').replace('D', '').replace('E', '').replace('F', '').replace('G', '').replace('H', '').replace('I', '').replace('J', '').replace('K', '').replace('L', '').replace('M', '').replace('N', '').replace('O', '').replace('P', '').replace('Q', '').replace('R', '').replace('S', '').replace('T', '').replace('U', '').replace('V', '').replace('W', '').replace('X', '').replace('Y', '').replace('Z', '').replace('/', '').replace('-', '').replace(' ', '').replace('_', '').replace('.', '').replace(':', '').replace(';', '').replace(',', '').replace('#', '').replace('(', '').replace(')', '').replace('[', '').replace(']', '').replace('{', '').replace('}', '')"/>
        <t t-set="barani_source_orders" t-value="o.invoice_line_ids.mapped('sale_line_ids.order_id')"/>
        <t t-set="barani_source_order_name" t-value="barani_source_orders[0].name if len(barani_source_orders) == 1 else (o.invoice_origin or '')"/>
        <t t-set="barani_source_display" t-value="barani_source_order_name if barani_source_order_name[:2] == 'SO' else (('SO' + barani_source_order_name[1:]) if barani_source_order_name[:1] == 'Q' and ',' not in barani_source_order_name and ';' not in barani_source_order_name else barani_source_order_name)"/>
        <t t-set="barani_credit_original_payment_ref_raw" t-value="((o.reversed_entry_id.invoice_origin if (o.move_type == 'out_refund' and o.reversed_entry_id) else '') or (o.invoice_origin if o.move_type == 'out_refund' else '') or ((o.reversed_entry_id.payment_reference or '') if (o.move_type == 'out_refund' and o.reversed_entry_id) else '') or ((o.reversed_entry_id.name or '') if (o.move_type == 'out_refund' and o.reversed_entry_id) else '') or (o.ref or ''))"/>
        <t t-set="barani_credit_original_payment_ref_upper" t-value="(barani_credit_original_payment_ref_raw or '').upper()"/>
        <t t-set="barani_credit_original_payment_ref" t-value="barani_credit_original_payment_ref_upper.replace('A', '').replace('B', '').replace('C', '').replace('D', '').replace('E', '').replace('F', '').replace('G', '').replace('H', '').replace('I', '').replace('J', '').replace('K', '').replace('L', '').replace('M', '').replace('N', '').replace('O', '').replace('P', '').replace('Q', '').replace('R', '').replace('S', '').replace('T', '').replace('U', '').replace('V', '').replace('W', '').replace('X', '').replace('Y', '').replace('Z', '').replace('/', '').replace('\\', '').replace('-', '').replace(' ', '').replace('_', '').replace('.', '').replace(':', '').replace(';', '').replace(',', '').replace('#', '').replace('(', '').replace(')', '').replace('[', '').replace(']', '').replace('{', '').replace('}', '').replace('\xa0', '')"/>

        <div class="row barani_vat_doc barani_addr_block">
          <div t-att-class="&quot;col-6 barani_addr_cell barani_customer_cell barani_has_shipping&quot; if o.partner_shipping_id else &quot;col-6 barani_addr_cell barani_customer_cell&quot;">
            <t t-if="o.move_type in ('out_invoice', 'out_refund')"><strong name="barani_customer_heading" class="barani_addr_heading" t-att-style="'color: %s;' % (o.company_id.secondary_color or '#ed1c24')">Customer:</strong></t>
            <t t-if="o.move_type in ('in_invoice', 'in_refund')"><strong name="barani_vendor_heading" class="barani_addr_heading" t-att-style="'color: %s;' % (o.company_id.secondary_color or '#ed1c24')">Vendor:</strong></t>
            <div t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: true}"/>
            <div t-if="o.partner_id.phone or o.partner_id.mobile" name="barani_customer_phone" class="mt-1"><span>Tel: </span><span t-esc="o.partner_id.phone or o.partner_id.mobile"/></div>
            <div t-if="o.partner_id.email" name="barani_customer_email" class="mt-1"><span>Email: </span><span t-field="o.partner_id.email"/></div>
            <t t-set="barani_customer_commercial_partner" t-value="o.partner_id.commercial_partner_id if o.partner_id else False"/>
            <t t-set="barani_customer_company_registry" t-value="o.partner_id.company_registry or (barani_customer_commercial_partner.company_registry if barani_customer_commercial_partner else '')"/>
            <t t-set="barani_customer_vat" t-value="o.partner_id.vat or (barani_customer_commercial_partner.vat if barani_customer_commercial_partner else '')"/>
            <div t-if="barani_customer_company_registry" name="barani_customer_company_registry" class="mt-1"><t t-if="':' in barani_customer_company_registry"><span t-esc="barani_customer_company_registry"/></t><t t-else="">ID: <span t-esc="barani_customer_company_registry"/></t></div>
            <div t-if="o.move_type in ('out_invoice','out_refund') or barani_customer_vat" name="barani_customer_vat" class="mt-1">
              VAT: <span t-esc="barani_customer_vat or 'N/A'"/>
            </div>
          </div>
          <div class="col-6 barani_addr_cell barani_shipping_cell" t-if="o.partner_shipping_id">
            <strong name="barani_shipping_heading" class="barani_addr_heading" t-att-style="'color: %s;' % (o.company_id.secondary_color or '#ed1c24')">Shipping Address:</strong>
            <div t-field="o.partner_shipping_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: true}"/>
            <div t-if="o.partner_shipping_id.phone or o.partner_shipping_id.mobile" name="barani_shipping_phone" class="mt-1"><span>Tel: </span><span t-esc="o.partner_shipping_id.phone or o.partner_shipping_id.mobile"/></div>
            <div t-if="o.partner_shipping_id.email" name="barani_shipping_email" class="mt-1"><span>Email: </span><span t-field="o.partner_shipping_id.email"/></div>
            <t t-set="barani_shipping_commercial_partner" t-value="o.partner_shipping_id.commercial_partner_id if o.partner_shipping_id else False"/>
            <t t-set="barani_shipping_company_registry" t-value="o.partner_shipping_id.company_registry or (barani_shipping_commercial_partner.company_registry if barani_shipping_commercial_partner else '')"/>
            <t t-set="barani_shipping_vat" t-value="o.partner_shipping_id.vat or (barani_shipping_commercial_partner.vat if barani_shipping_commercial_partner else '')"/>
            <div t-if="barani_shipping_company_registry" name="barani_shipping_company_registry" class="mt-1"><t t-if="':' in barani_shipping_company_registry"><span t-esc="barani_shipping_company_registry"/></t><t t-else="">ID: <span t-esc="barani_shipping_company_registry"/></t></div>
            <div t-if="o.move_type in ('out_invoice','out_refund') or barani_shipping_vat" name="barani_shipping_vat" class="mt-1">
              VAT: <span t-esc="barani_shipping_vat or 'N/A'"/>
            </div>
          </div>
        </div>

        <div class="page barani_vat_doc">
          <t t-set="barani_month_abbr_en" t-value="{'01': 'JAN', '02': 'FEB', '03': 'MAR', '04': 'APR', '05': 'MAY', '06': 'JUN', '07': 'JUL', '08': 'AUG', '09': 'SEP', '10': 'OCT', '11': 'NOV', '12': 'DEC'}"/>
          <t t-set="barani_invoice_date_iso" t-value="'%s' % (o.invoice_date or '')"/>
          <t t-set="barani_invoice_date_display" t-value="(barani_invoice_date_iso[8:10] + ' ' + barani_month_abbr_en.get(barani_invoice_date_iso[5:7], barani_invoice_date_iso[5:7]) + ' ' + barani_invoice_date_iso[0:4]) if len(barani_invoice_date_iso) &gt;= 10 else barani_invoice_date_iso"/>
          <t t-set="barani_due_date_iso" t-value="'%s' % (o.invoice_date_due or '')"/>
          <t t-set="barani_due_date_display" t-value="(barani_due_date_iso[8:10] + ' ' + barani_month_abbr_en.get(barani_due_date_iso[5:7], barani_due_date_iso[5:7]) + ' ' + barani_due_date_iso[0:4]) if len(barani_due_date_iso) &gt;= 10 else barani_due_date_iso"/>
          <div id="informations" class="row mt-3 barani_info_block">
            <div class="col-2 mb-2" t-if="o.invoice_date" name="invoice_date">
              <t t-if="o.move_type == 'out_invoice'"><strong>Invoice Date</strong></t>
              <t t-elif="o.move_type == 'out_refund'"><strong>Credit Note Date</strong></t>
              <t t-else=""><strong>Date</strong></t>
              <p class="m-0"><span name="barani_display_invoice_date" t-esc="barani_invoice_date_display"/></p>
            </div>
            <div class="col-2 mb-2" t-if="o.invoice_date and o.move_type in ('out_invoice','out_refund')" name="vat_date">
              <strong>VAT Date</strong><p class="m-0"><span name="barani_display_vat_date" t-esc="barani_invoice_date_display"/></p>
            </div>
            <div class="col-2 mb-2" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">
              <strong>Due Date</strong><p class="m-0"><span name="barani_display_due_date" t-esc="barani_due_date_display"/></p>
            </div>
            <div class="col-2 mb-2" t-if="barani_source_display" name="origin">
              <strong>Source</strong><p class="m-0"><span t-esc="barani_source_display"/></p>
            </div>
            <div class="col-2 mb-2" name="barani_credit_original_invoice" t-if="o.move_type in ('out_refund','in_refund') and (o.reversed_entry_id or o.ref)">
              <strong>Original Invoice</strong><p class="m-0"><span t-esc="(o.reversed_entry_id.name if o.reversed_entry_id else '') or (o.ref or '')"/></p>
            </div>
            <div class="col-3 mb-2" name="barani_credit_original_payment_reference" t-if="o.move_type in ('out_refund','in_refund') and barani_credit_original_payment_ref">
              <strong>Original Payment Reference</strong><p class="m-0"><span t-esc="barani_credit_original_payment_ref"/></p>
            </div>
            <div class="col-2 mb-2" t-if="o.ref and o.move_type not in ('out_refund','in_refund')" name="reference">
              <strong>Reference</strong><p class="m-0" t-field="o.ref"/>
            </div>
            <div class="col-2 mb-2" t-if="barani_pdf_payment_ref and o.move_type in ('out_invoice','in_refund')" name="payment_reference">
              <strong>Payment Reference</strong><p class="m-0"><span t-esc="barani_pdf_payment_ref"/></p>
            </div>
            <div class="col-2 mb-2" t-if="o.move_type == 'out_invoice'" name="payment_method">
              <strong>Payment Method</strong><p class="m-0">Wire transfer</p>
            </div>
          </div>

          <table class="table table-sm o_main_table barani_vat_table" name="invoice_line_table">
            <colgroup>
              <col style="width:37%"/>
              <col style="width:8%"/>
              <col name="barani_coo_col_final" style="width:5%"/>
              <col style="width:6.5%"/>
              <col name="barani_unit_col_wide" style="width:7%"/>
              <col style="width:8%"/>
              <col name="barani_discount_col_fixed" style="width:5.5%"/>
              <col name="barani_vat_rate_col_final" style="width:5.5%"/>
              <col style="width:7.5%"/>
              <col style="width:10%"/>
            </colgroup>
            <thead>
              <tr>
                <th name="th_description" class="text-start"><span>Description</span></th>
                <th name="th_hscode" class="text-start"><span>HS Code</span></th>
                <th name="th_coo" class="text-center"><span>COO</span></th>
                <th name="th_quantity" class="text-end"><span>Qty</span></th>
                <th name="th_uom" class="text-start"><span>Unit</span></th>
                <th name="th_priceunit" class="text-end"><span>Unit Price</span></th>
                <th name="th_discount" class="text-end"><span>Disc.</span></th>
                <th name="th_vatrate" class="text-end"><span>VAT Rate</span></th>
                <th name="th_vatamount" class="text-end"><span>VAT</span></th>
                <th name="th_vatbase" class="text-end"><span>VAT Base</span></th>
              </tr>
            </thead>
            <tbody class="invoice_tbody">
              <t t-foreach="o.invoice_line_ids" t-as="line">
                <t t-set="barani_line_is_real" t-value="line.display_type not in ('line_section','line_note')"/>
                <t t-set="barani_line_is_324" t-value="barani_line_is_real and line.account_id and line.account_id.code and line.account_id.code[:3] == '324'"/>
                <t t-set="barani_line_in_table" t-value="barani_line_is_real and ((barani_is_dp_only and barani_line_is_324 and (line.price_subtotal or 0.0) &gt;= -0.005) or ((not barani_is_dp_only) and not barani_line_is_324))"/>

                <tr t-if="barani_line_in_table">
                  <td name="td_name"><span t-field="line.name" t-options="{&quot;widget&quot;: &quot;text&quot;}"/></td>
                  <td name="td_hscode" class="text-start"><span t-if="line.product_id.hs_code" t-field="line.product_id.hs_code"/></td>
                  <td name="td_coo" class="text-center"><span t-if="line.product_id.country_of_origin" t-field="line.product_id.country_of_origin.code"/></td>
                  <td name="td_qty" class="text-end"><span t-field="line.quantity"/></td>
                  <td name="td_unit" class="text-start"><span t-field="line.product_uom_id" groups="uom.group_uom"/></td>
                  <td name="td_priceunit" class="text-end"><span class="text-nowrap" name="barani_unit_price_currency"><span t-field="line.price_unit" t-options="{&quot;widget&quot;: &quot;float&quot;, &quot;precision&quot;: 2}"/> <span t-esc="o.currency_id.symbol"/></span></td>
                  <td name="td_discount" class="text-end"><span class="text-nowrap" name="barani_discount_percent_cell"><span t-esc="('%.1f' % line.discount).rstrip('0').rstrip('.')"/> %</span></td>
                  <td name="td_vatrate" class="text-end"><t t-set="barani_numeric_vat_rate_taxes" t-value="line.tax_ids.flatten_taxes_hierarchy()"/><t t-if="barani_numeric_vat_rate_taxes"><t t-foreach="barani_numeric_vat_rate_taxes" t-as="barani_numeric_vat_rate_tax"><span t-if="barani_numeric_vat_rate_tax_index">, </span><span class="text-nowrap"><t t-if="barani_numeric_vat_rate_tax.amount_type in ('percent', 'division')"><span t-esc="'%g' % barani_numeric_vat_rate_tax.amount"/> %</t><t t-else="">N/A</t></span></t></t><t t-if="not barani_numeric_vat_rate_taxes"><span class="text-nowrap">N/A</span></t></td>
                  <td name="td_vatamount" class="text-end"><span class="text-nowrap" t-esc="line.price_total - line.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td>
                  <td name="td_vatbase" class="text-end o_price_total"><span class="text-nowrap" t-field="line.price_subtotal"/></td>
                </tr>

                <tr t-if="line.display_type == 'line_section' and line.name != 'Down Payments'" class="bg-200 fw-bold o_line_section">
                  <td colspan="10"><span t-field="line.name" t-options="{&quot;widget&quot;: &quot;text&quot;}"/></td>
                </tr>
                <tr t-if="line.display_type == 'line_note'" class="fst-italic o_line_note">
                  <td colspan="10"><span t-field="line.name" t-options="{&quot;widget&quot;: &quot;text&quot;}"/></td>
                </tr>
              </t>

              <tr class="border-black o_total fw-bold">
                <td class="text-end" colspan="7"><span>Totals</span></td>
                <td class="text-end"><span>VAT</span></td>
                <td class="text-end"><span t-esc="barani_official_goods_vat" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td>
                <td class="text-end"><span t-esc="barani_total_base" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td>
              </tr>
            </tbody>
          </table>

          <div name="barani_down_payment_reconciliation_table" t-if="barani_has_advance_deduction and o.move_type == 'out_invoice'" style="margin:6px 0 6px 0;">
            <table class="table table-sm barani_down_payment_reconciliation_table">
              <colgroup>
                <col style="width:49%"/>
                <col style="width:17%"/>
                <col style="width:17%"/>
                <col style="width:17%"/>
              </colgroup>
              <thead>
                <tr>
                  <th class="text-start">Down payment reconciliation</th>
                  <th class="text-end">Base excl. VAT</th>
                  <th class="text-end">VAT</th>
                  <th class="text-end">Total incl. VAT</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Goods/services before down payments</td>
                  <td class="text-end"><span t-esc="barani_total_base" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td>
                  <td class="text-end"><span t-esc="barani_official_goods_vat" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td>
                  <td class="text-end"><span t-esc="barani_goods_gross" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td>
                </tr>
                <t t-foreach="barani_ded_lines" t-as="bvt_rec_dl">
                  <t t-set="bvt_rec_src" t-value="bvt_rec_dl.sale_line_ids.invoice_lines.move_id.filtered(lambda m: m.id != o.id and m.move_type == 'out_invoice' and m.state == 'posted')"/>
                  <t t-set="bvt_rec_is_dp" t-value="any(s.is_downpayment for s in bvt_rec_dl.sale_line_ids)"/>
                  <t t-set="bvt_rec_label" t-value="('Down Payment Invoice ' + bvt_rec_src[0].name) if (bvt_rec_is_dp and bvt_rec_src and bvt_rec_src[0].name and bvt_rec_src[0].name != '/') else 'Down payment deduction'"/>
                  <t t-set="bvt_rec_payment_widget" t-value="bvt_rec_src[0].invoice_payments_widget if bvt_rec_src else False"/>
                  <t t-set="bvt_rec_payment_items" t-value="bvt_rec_payment_widget.get('content') if (bvt_rec_payment_widget and bvt_rec_payment_widget.get('content')) else []"/>
                  <tr>
                    <td>Less: <t t-esc="bvt_rec_label"/><div t-if="bvt_rec_payment_items" name="barani_down_payment_received_dates" class="text-muted" style="font-size:8pt; line-height:1.1; margin-top:1px;"><t t-foreach="bvt_rec_payment_items" t-as="bvt_pay"><div><t t-set="bvt_pay_date_iso" t-value="'%s' % (bvt_pay.get('date') or '')"/><t t-set="bvt_pay_date_display" t-value="(bvt_pay_date_iso[8:10] + ' ' + barani_month_abbr_en.get(bvt_pay_date_iso[5:7], bvt_pay_date_iso[5:7]) + ' ' + bvt_pay_date_iso[0:4]) if len(bvt_pay_date_iso) &gt;= 10 else bvt_pay_date_iso"/>Payment received: <span name="barani_down_payment_received_date_display" t-esc="bvt_pay_date_display"/></div></t></div></td>
                    <td class="text-end"><span t-esc="bvt_rec_dl.price_subtotal or 0.0" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td>
                    <td class="text-end"><span t-esc="(bvt_rec_dl.price_total or 0.0) - (bvt_rec_dl.price_subtotal or 0.0)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td>
                    <td class="text-end"><span t-esc="bvt_rec_dl.price_total or 0.0" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td>
                  </tr>
                </t>
                <tr class="border-black fw-bold">
                  <td><strong>Invoice total after down payments</strong></td>
                  <td class="text-end"><strong><span t-esc="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></strong></td>
                  <td class="text-end"><strong><span t-esc="o.amount_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></strong></td>
                  <td class="text-end"><strong><span t-esc="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></strong></td>
                </tr>
              </tbody>
            </table>
          </div>

          <div name="barani_notes_totals_table" style="display:table; width:100%; table-layout:fixed; margin-top:3px;">
            <div name="barani_notes_cell" style="display:table-cell; width:57%; vertical-align:top; font-size:10pt; line-height:1.25; padding:0 12px 0 0;">
              <p t-if="(barani_line_vat_sum - barani_official_goods_vat) &gt; 0.005 or (barani_official_goods_vat - barani_line_vat_sum) &gt; 0.005" class="text-muted" style="font-size:10pt; margin:0 0 6px 0;">VAT is rounded globally; the VAT total follows Odoo's official tax rounding. Sum of displayed line VAT amounts: <span t-esc="barani_line_vat_sum" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>.</p>
              <t t-set="barani_incoterm_code" t-value="o.invoice_incoterm_id.code or '' if o.invoice_incoterm_id else ''"/>
              <t t-set="barani_incoterm_name" t-value="o.invoice_incoterm_id.name or '' if o.invoice_incoterm_id else ''"/>
              <t t-set="barani_incoterm_display" t-value="barani_incoterm_code + ((' (' + barani_incoterm_name + ')') if (barani_incoterm_name and barani_incoterm_name != barani_incoterm_code) else '')"/>
              <div name="barani_incoterms_line" style="margin:0 0 4px 0; font-size:10pt; line-height:1.25;">
                <t t-set="barani_incoterm_source_orders" t-value="o.invoice_line_ids.mapped('sale_line_ids.order_id')"/><t t-set="barani_incoterm_source_order" t-value="barani_incoterm_source_orders[0] if len(barani_incoterm_source_orders) == 1 else False"/><t t-set="barani_incoterm_location_raw" t-value="(barani_incoterm_source_order and barani_incoterm_source_order.incoterm_location) or ''"/><t t-set="barani_incoterm_location_display" t-value="barani_incoterm_location_raw or ('Brectanova 2353/1, 83101 Bratislava, SVK' if barani_incoterm_code == 'EXW' else '')"/><strong>INCOTERMS:</strong> <span name="barani_incoterms_code_name" t-esc="(barani_incoterm_display + ((' — ' + barani_incoterm_location_display) if barani_incoterm_location_display else '')) if o.invoice_incoterm_id else 'Not specified'"/>
              </div>
              <div t-if="o.fiscal_position_id" name="barani_fiscal_position_note" style="margin:0 0 4px 0; font-size:10pt; line-height:1.25;">
                <strong>Fiscal position:</strong> <span t-field="o.fiscal_position_id.name"/>
              </div>
              <div t-if="not is_html_empty(o.fiscal_position_id.note)" name="barani_fiscal_position_note_text" style="margin:0 0 4px 0; font-size:10pt; line-height:1.25;">
                <span t-field="o.fiscal_position_id.note"/>
              </div>
              <div t-if="o.intrastat_transport_mode_id" name="barani_intrastat_transport_code" style="margin:0 0 4px 0; font-size:10pt; line-height:1.25;">
                <strong>INTRASTAT transport code:</strong> <span t-esc="o.intrastat_transport_mode_id.display_name"/>
              </div>
            </div>
            <div id="total" name="barani_totals_cell" style="display:table-cell; width:43%; vertical-align:top;">
                <table class="table table-sm">
                                    <t t-if="barani_has_advance_deduction and o.move_type in ('out_invoice','out_refund')">
                  <tr>
                    <td>Subtotal after down payments (excl. VAT)</td>
                    <td class="text-end"><span t-esc="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td>
                  </tr>
                  <tr>
                    <td>VAT after down payments</td>
                    <td class="text-end"><span t-esc="o.amount_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td>
                  </tr>
                  <tr class="border-black fw-bold" name="barani_invoice_total_after_down_payments">
                    <td><strong>Invoice total after down payments</strong></td>
                    <td class="text-end"><strong><span t-esc="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></strong></td>
                  </tr>
                  <tr class="border-black fw-bold">
                    <td><strong><t t-esc="'Amount credited' if o.move_type == 'out_refund' else 'Balance Due'"/></strong></td>
                    <td class="text-end"><strong><span t-esc="o.amount_total if o.move_type == 'out_refund' else o.amount_residual" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></strong></td>
                  </tr>
                  <tr>
                    <td>Currency</td>
                    <td class="text-end"><span t-esc="o.currency_id.name or 'EUR'"/></td>
                  </tr>
                  </t>
                  <t t-if="not barani_has_advance_deduction">
                  <tr>
                    <td><t t-esc="'Subtotal (excl. VAT)' if barani_is_dp_invoice else 'Total excl. VAT'"/></td>
                    <td class="text-end"><span t-esc="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td>
                  </tr>
                  <tr>
                    <td>Total VAT</td>
                    <td class="text-end"><span t-esc="o.amount_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></td>
                  </tr>
                  <tr class="border-black">
                    <td><strong>Total incl. VAT</strong></td>
                    <td class="text-end"><strong><span t-esc="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></strong></td>
                  </tr>
                    <t t-if="(not barani_is_dp_invoice) and o.move_type == 'out_invoice' and o.state == 'posted'">
                  <tr class="border-black fw-bold">
                    <td><strong>Balance Due</strong></td>
                    <td class="text-end"><strong><span t-field="o.amount_residual"/></strong></td>
                  </tr>
                    </t>
                    <t t-if="o.move_type == 'out_refund' and o.state == 'posted'">
                  <tr class="border-black fw-bold">
                    <td><strong>Amount credited</strong></td>
                    <td class="text-end"><strong><span t-esc="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></strong></td>
                  </tr>
                    </t>
                  <tr>
                    <td>Currency</td>
                    <td class="text-end"><span t-esc="o.currency_id.name or 'EUR'"/></td>
                  </tr>
                  </t>
                </table>
            </div>
          </div>

          <t t-set="barani_note_source_orders" t-value="o.invoice_line_ids.sale_line_ids.order_id"/>
          <t t-set="barani_note_source_order" t-value="barani_note_source_orders[0] if barani_note_source_orders else False"/>
          <div t-if="not is_html_empty(o.narration)" name="comment"><span t-field="o.narration"/></div>
          <div t-if="is_html_empty(o.narration) and barani_note_source_order and not is_html_empty(barani_note_source_order.note)" name="barani_sale_order_note_fallback"><span t-field="barani_note_source_order.note"/></div>

          <t t-set="barani_invoice_payment_widget" t-value="o.invoice_payments_widget if o.invoice_payments_widget else False"/>
          <t t-set="barani_invoice_payment_items" t-value="barani_invoice_payment_widget.get('content') if (barani_invoice_payment_widget and barani_invoice_payment_widget.get('content')) else []"/>
          <div t-if="barani_invoice_payment_items and o.move_type == 'out_invoice'" name="barani_payment_received_note" style="font-size:9pt; line-height:1.15; margin:4px 0 4px 0;">
            <strong>Payment received:</strong>
            <t t-foreach="barani_invoice_payment_items" t-as="barani_pay">
              <div style="margin-left:10px;">
                <t t-set="barani_pay_date_iso" t-value="'%s' % (barani_pay.get('date') or '')"/><t t-set="barani_pay_date_display" t-value="(barani_pay_date_iso[8:10] + ' ' + barani_month_abbr_en.get(barani_pay_date_iso[5:7], barani_pay_date_iso[5:7]) + ' ' + barani_pay_date_iso[0:4]) if len(barani_pay_date_iso) &gt;= 10 else barani_pay_date_iso"/><span name="barani_payment_received_display_date" t-esc="barani_pay_date_display"/>
                <t t-if="not barani_is_dp_invoice"><span> — </span><span t-esc="barani_pay.get('amount')" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/></t>
              </div>
            </t>
          </div>

          <p class="text-muted" style="font-size:8pt; margin-top:6px;">COO = Country of Origin</p>

          <!-- D03.1: barani_pdf_payment_ref computed before header metadata -->
          <t t-set="barani_bank_iban_compact" t-value="(o.partner_bank_id.acc_number or '').replace(' ', '') if o.partner_bank_id else ''"/>
          <t t-set="barani_bank_bic_compact" t-value="(o.partner_bank_id.bank_id.bic or '').replace(' ', '') if (o.partner_bank_id and o.partner_bank_id.bank_id) else ''"/>
          <t t-set="barani_invoice_bank_ok" t-value="o.partner_bank_id and barani_bank_iban_compact == 'SK1483300000002401465895' and barani_bank_bic_compact == 'FIOZSKBAXXX'"/>
          <t t-set="barani_company_receiving_banks" t-value="o.company_id.partner_id.bank_ids.filtered(lambda b: (b.acc_number or '').replace(' ', '') == 'SK1483300000002401465895' and b.bank_id and (b.bank_id.bic or '').replace(' ', '') == 'FIOZSKBAXXX')"/>
          <t t-set="barani_effective_bank" t-value="o.partner_bank_id if barani_invoice_bank_ok else (barani_company_receiving_banks[0] if barani_company_receiving_banks else False)"/>
          <t t-set="barani_receiving_bank_ok" t-value="bool(barani_effective_bank)"/>
          <t t-set="barani_bank_record" t-value="barani_effective_bank.bank_id if (barani_effective_bank and barani_effective_bank.bank_id) else False"/>
          <t t-set="barani_bank_has_address" t-value="barani_bank_record and (barani_bank_record.street or barani_bank_record.city or barani_bank_record.country)"/>
          <div name="barani_bank_transfer_band" t-if="o.move_type != 'out_refund' and (barani_effective_bank or barani_pdf_payment_ref or o.invoice_date_due)" style="display:table; width:100%; table-layout:fixed; background-color:#E79C9C; font-size:9pt; line-height:1.2;">
            <div name="barani_bank_details_cell" class="barani_footer_band" style="display:table-cell; width:70%; text-align:left; vertical-align:top; background-color:#E79C9C; padding:3px 6px;" t-if="barani_effective_bank">
              <div><strong>Bank transfer:</strong></div>
              <div><span>IBAN: </span><span t-field="barani_effective_bank.acc_number"/><span> | SWIFT/BIC: </span><span t-field="barani_effective_bank.bank_id.bic"/></div>
              <div t-if="barani_bank_record and (barani_bank_record.name or barani_bank_has_address)">
                <t t-if="barani_bank_record.name"><span>Bank: </span><span t-field="barani_bank_record.name"/></t>
                <t t-if="barani_bank_record.name and barani_bank_has_address"><span> | </span></t>
                <t t-if="barani_bank_has_address">
                  <t t-set="barani_bank_city_line" t-value="(barani_bank_record.zip or '') + (' ' if (barani_bank_record.zip and barani_bank_record.city) else '') + (barani_bank_record.city or '')"/>
                  <t t-set="barani_bank_address_text" t-value="(barani_bank_record.street or '') + ((', ' + barani_bank_city_line) if (barani_bank_city_line and barani_bank_record.street) else (barani_bank_city_line if barani_bank_city_line and not barani_bank_record.street else '')) + ((', ' + barani_bank_record.country.name) if (barani_bank_record.country and ((barani_bank_record.street or '') or barani_bank_city_line)) else (barani_bank_record.country.name if barani_bank_record.country else ''))"/>
                  <span>Bank address: </span><span name="barani_bank_address_clean" t-esc="barani_bank_address_text"/>
                </t>
              </div>
            </div>
            <div name="barani_payment_ref_cell" class="barani_footer_band" t-if="barani_pdf_payment_ref" t-att-style="'display:table-cell; width:12.5%; text-align:right; vertical-align:top; background-color:#E79C9C; padding:3px 6px;' if (barani_effective_bank and o.invoice_date_due) else 'display:table-cell; width:25%; text-align:right; vertical-align:top; background-color:#E79C9C; padding:3px 6px;' if barani_effective_bank else 'display:table-cell; width:50%; text-align:right; vertical-align:top; background-color:#E79C9C; padding:3px 6px;' if o.invoice_date_due else 'display:table-cell; width:100%; text-align:right; vertical-align:top; background-color:#E79C9C; padding:3px 6px;'"><span><strong>Payment Reference:</strong><br/></span><span t-esc="barani_pdf_payment_ref"/></div>
            <div name="barani_due_date_cell" class="barani_footer_band" t-if="o.invoice_date_due" t-att-style="'display:table-cell; width:12.5%; text-align:right; vertical-align:top; background-color:#E79C9C; padding:3px 6px;' if (barani_effective_bank and barani_pdf_payment_ref) else 'display:table-cell; width:25%; text-align:right; vertical-align:top; background-color:#E79C9C; padding:3px 6px;' if barani_effective_bank else 'display:table-cell; width:50%; text-align:right; vertical-align:top; background-color:#E79C9C; padding:3px 6px;' if barani_pdf_payment_ref else 'display:table-cell; width:100%; text-align:right; vertical-align:top; background-color:#E79C9C; padding:3px 6px;'"><span><strong>Due Date:</strong><br/></span><span name="barani_footer_due_date" t-esc="barani_due_date_display"/></div>
          </div>

          <t t-set="barani_issued_by" t-value="o.invoice_user_id.name if o.invoice_user_id else (o.create_uid.name if o.create_uid else '')"/>
          <div class="row mt-4" name="barani_issued_by_slot"><div class="col-12 text-end" style="padding-right:33%; font-size:10pt;"><span><strong>Prepared by / Issued by:</strong> </span><span t-esc="barani_issued_by"/></div></div>

          <!-- L15.2: payment QR intentionally omitted; bank transfer details use confirmed invoice recipient bank only. -->
        </div>
      </t>
    </t>
  </t>
</t>
